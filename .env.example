# ──────────────────────────────────────────────────────────────
#  Polla Mundialista · Familia Rivera Arcos · Variables de Entorno
# ──────────────────────────────────────────────────────────────
#
# En Vercel: Settings → Environment Variables
# (Vercel Postgres agrega POSTGRES_URL automáticamente al crear el storage)
#

# PostgreSQL — Vercel Postgres (se genera automático) o cualquier Postgres
POSTGRES_URL=postgres://usuario:contraseña@host:5432/nombre_db

# JWT Secret (genera uno aleatorio, ej: openssl rand -base64 32)
JWT_SECRET=cambia-esto-por-algo-secreto-y-largo
